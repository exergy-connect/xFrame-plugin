{
  "manifest_version": 3,
  "name": "Exergy \u221e xFrame",
  "version": "1.4.0",
  "description": "Exergy \u221e xFrame records a web session as MP4, takes PNG snapshots, and creates animated GIFs from recordings.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Exergy \u221e xFrame",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "take-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Take a PNG snapshot of the visible tab"
    }
  },
  "permissions": [
    "tabCapture",
    "audioCapture",
    "offscreen",
    "downloads",
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "assets/favicon.svg",
        "assets/favicon.ico",
        "assets/exergy_connect_logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  }
}
