{
  "manifest_version": 3,
  "name": "Exergy ∞ xFrame",
  "version": "1.0.3",
  "description": "Exergy ∞ xFrame records a web session as MP4 and takes PNG snapshots of the visible tab.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Exergy ∞ xFrame",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "take-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Take a PNG snapshot of the visible tab"
    }
  },
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": [
        "content.css",
        "assets/favicon.svg",
        "assets/favicon.ico",
        "assets/exergy_connect_logo.png"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
